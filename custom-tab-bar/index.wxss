.tab-host { position: fixed; z-index: 999; right: 0; bottom: 0; left: 0; padding: 0 28rpx calc(18rpx + env(safe-area-inset-bottom)); pointer-events: none; }
.tab-shell { display: grid; grid-template-columns: repeat(5, 1fr); min-height: 118rpx; padding: 14rpx 8rpx 8rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 44rpx; background: rgba(255,255,255,.84); box-shadow: 0 18rpx 48rpx rgba(72,126,165,.16); -webkit-backdrop-filter: blur(28rpx); backdrop-filter: blur(28rpx); pointer-events: auto; }
.tab-item { display: flex; position: relative; flex-direction: column; align-items: center; justify-content: center; color: #476987; font-size: 21rpx; }
.tab-item.selected { color: #4aa8e9; }
.tab-icon-wrap { display: flex; position: relative; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; }
.tab-icon { position: relative; z-index: 2; width: 44rpx; height: 44rpx; }
.tab-item text { position: relative; z-index: 2; margin-top: 2rpx; }
.active-ripple { position: absolute; z-index: 1; bottom: -27rpx; left: 50%; width: 90rpx; height: 24rpx; border: 2rpx solid rgba(95,181,238,.24); border-radius: 50%; transform: translateX(-50%); }
.active-ripple::after { position: absolute; top: 5rpx; left: 50%; width: 58rpx; height: 14rpx; border: 2rpx solid rgba(95,181,238,.18); border-radius: 50%; content: ''; transform: translateX(-50%); }
.main-tab .tab-icon-wrap { width: 68rpx; height: 68rpx; margin-top: -22rpx; border: 2rpx solid rgba(255,255,255,.96); border-radius: 23rpx; background: linear-gradient(145deg, rgba(218,242,255,.96), rgba(255,225,238,.94)); box-shadow: 0 10rpx 25rpx rgba(75,132,172,.17); }
.main-tab .tab-icon { width: 56rpx; height: 56rpx; }
.main-tab text { margin-top: 0; }
