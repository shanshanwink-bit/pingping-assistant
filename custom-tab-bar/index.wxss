.tab-host {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 32rpx 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-shell {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  min-height: 100rpx;
  padding: 8rpx 8rpx 6rpx;
  border: 1rpx solid #e5e2de;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(37, 37, 37, .05);
  pointer-events: auto;
}

.tab-item {
  display: flex;
  position: relative;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6e7074;
  font-size: 20rpx;
}

.tab-item.selected { color: #8e3655; }
.tab-icon-wrap { display: flex; position: relative; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; }
.tab-icon { position: relative; z-index: 2; width: 40rpx; height: 40rpx; }
.tab-label { position: relative; z-index: 2; margin-top: 0; }
.active-ripple { display: none; }
