NODE_ENV=production
HOST=127.0.0.1
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pingping_assistant
MYSQL_USER=pingping_api
MYSQL_PASSWORD=replace-on-server
JWT_SECRET=replace-with-at-least-32-random-characters
WECHAT_APP_ID=replace-on-server
WECHAT_APP_SECRET=replace-on-server
# 个人店铺模式：把允许登录的小程序微信账号绑定到后台同一店铺。
PRIMARY_STORE_ID=00000000-0000-4000-8000-000000000001
WECHAT_ALLOWED_OPENIDS=replace-with-owner-openid
# 面试体验模式默认关闭。启用前必须先独立初始化 Demo 店和 clerk 成员，不得填写真实门店或真实用户。
DEMO_LOGIN_ENABLED=false
DEMO_STORE_ID=
DEMO_USER_ID=
DEMO_TOKEN_TTL_SECONDS=7200
ADMIN_ORIGINS=https://admin.example.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.7-plus
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_IMAGE_BYTES=4194304
AI_RATE_LIMIT_WINDOW_MS=60000
