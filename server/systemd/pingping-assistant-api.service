[Unit]
Description=Pingping Assistant API
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/opt/pingping-assistant-api
EnvironmentFile=/etc/pingping-assistant-api.env
ExecStart=/usr/bin/node /opt/pingping-assistant-api/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/pingping-assistant
MemoryMax=320M
TasksMax=128

[Install]
WantedBy=multi-user.target
