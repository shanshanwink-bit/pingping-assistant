@import "styles/simple-theme.wxss";
@import "styles/simple-page-overrides.wxss";

page {
  --color-brand: #8e3655;
  --color-brand-strong: #742a44;
  --color-brand-soft: #f4e7ec;
  --color-accent: #b58a50;
  --color-accent-soft: #f7f0e5;
  --color-canvas: #f7f5f2;
  --color-surface: #ffffff;
  --color-surface-muted: #faf8f5;
  --color-text: #2b2927;
  --color-text-secondary: #8a8580;
  --color-text-muted: #aaa49e;
  --color-border: #ece8e3;
  --color-success: #477a62;
  --color-warning: #b47636;
  --color-danger: #b9545f;
  min-height: 100%;
  background: var(--color-canvas);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 48rpx;
  background: transparent !important;
}

.page-title {
  margin: 6rpx 0 24rpx;
  color: var(--color-text) !important;
  font-size: 44rpx;
  font-weight: 600;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 4rpx 18rpx;
}

.section-title { color: var(--color-text) !important; font-size: 30rpx; font-weight: 600; }
.section-subtitle,
.page-subtitle { color: var(--color-text-secondary) !important; }
.link-text { color: var(--color-brand) !important; font-size: 25rpx; }

.card {
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 24rpx rgba(34, 34, 34, .04);
}

.primary-button,
.secondary-button {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.primary-button { border: 1rpx solid var(--color-brand) !important; color: #fff !important; background: var(--color-brand) !important; box-shadow: none !important; }
.secondary-button { border: 1rpx solid var(--color-border) !important; color: var(--color-text) !important; background: #fff !important; box-shadow: none !important; }
.button-row { display: flex; margin-top: 36rpx; }
.button-row > button { width: 0; min-width: 0; flex: 1 1 0; box-sizing: border-box; margin: 0; }
.button-row > button + button { margin-left: 20rpx; }

.empty { padding: 72rpx 24rpx; color: var(--color-text-secondary) !important; text-align: center; }
.field { margin-bottom: 28rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: var(--color-text-secondary) !important; font-size: 25rpx; }
.input,
.picker-value,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border) !important;
  border-radius: 18rpx;
  color: var(--color-text) !important;
  background: #fff !important;
  box-shadow: none !important;
}
.input,
.picker-value { height: 88rpx; padding: 0 24rpx; line-height: 88rpx; }
.textarea { min-height: 150rpx; padding: 20rpx 24rpx; }
.hint { margin-top: 10rpx; color: var(--color-text-muted) !important; font-size: 23rpx; line-height: 1.6; }
.required,
.danger-text { color: var(--color-danger) !important; }
.tag { display: inline-flex; min-height: 44rpx; align-items: center; padding: 0 16rpx; border-radius: 999rpx; color: var(--color-brand) !important; background: var(--color-brand-soft) !important; font-size: 23rpx; }
