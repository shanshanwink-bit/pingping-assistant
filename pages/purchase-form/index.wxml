<view class="page purchase-page">
  <view class="purchase-heading">
    <view class="page-title">记一笔拿货</view>
    <text>填数量和单价，库存与成本自动计算</text>
  </view>

  <view wx:if="{{products.length}}">
    <view class="selection-card">
      <picker range="{{productNames}}" value="{{productIndex}}" bindchange="onProductChange">
        <view class="selection-row">
          <view><text>商品</text><view>{{currentProduct.name}}</view></view>
          <text class="selection-arrow">更换 ›</text>
        </view>
      </picker>
      <picker range="{{specNames}}" value="{{specIndex}}" bindchange="onSpecChange">
        <view class="selection-row">
          <view><text>{{specLabel}}</text><view>{{currentSpec.color}} / {{currentSpec.size}}</view></view>
          <text class="selection-arrow">更换 ›</text>
        </view>
      </picker>
    </view>

    <view class="core-entry-card">
      <view class="entry-grid">
        <view class="entry-field">
          <label><text>*</text> 拿货数量</label>
          <view class="entry-input"><input type="number" placeholder="0" data-field="quantity" value="{{quantity}}" bindinput="onInput" /><text>件</text></view>
        </view>
        <view class="entry-field">
          <label><text>*</text> 单件拿货价</label>
          <view class="entry-input"><text>¥</text><input type="digit" placeholder="0.00" data-field="unitCost" value="{{unitCost}}" bindinput="onInput" /></view>
        </view>
      </view>

      <view class="stock-change" wx:if="{{currentSpec}}">库存将从 <text>{{currentSpec.stock}}</text> 件变为 <text>{{afterStock}}</text> 件</view>

      <view class="total-row">
        <view><text>本次拿货总额</text><view>{{quantity || 0}} 件 × ¥{{unitCost || '0.00'}}</view></view>
        <view>{{totalCostText}}</view>
      </view>
    </view>

    <view class="more-toggle" bindtap="toggleMore">
      <view><view>供应商与备注</view><text>选填</text></view>
      <text>{{showMore ? '收起' : '填写'}} {{showMore ? '⌃' : '⌄'}}</text>
    </view>
    <view class="more-card" wx:if="{{showMore}}">
      <view class="field"><label class="field-label">供应商</label><input class="input" placeholder="{{supplierPlaceholder}}" data-field="supplier" value="{{supplier}}" bindinput="onInput" /></view>
      <view class="field last-field"><label class="field-label">备注</label><textarea class="textarea" maxlength="100" placeholder="可填写拿货单号或其他说明" data-field="note" value="{{note}}" bindinput="onInput" /></view>
    </view>

    <button class="save-purchase" bindtap="submit">确认拿货 · {{totalCostText}}</button>
  </view>

  <view wx:else class="empty-product"><view class="empty-icon">{{emptyIcon}}</view><view>还没有商品档案</view><text>需要先创建商品和规格，再登记拿货。</text><button class="primary-button" bindtap="addProduct">新建第一个商品</button></view>
</view>
