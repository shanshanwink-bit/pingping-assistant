<view class="page profile-page">
  <view class="page-title">我的</view>
  <view class="user-card card" wx:if="{{userReady}}">
    <image wx:if="{{userView.hasAvatar}}" class="user-avatar" src="{{userView.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="user-avatar avatar-fallback">{{userView.avatarText}}</view>
    <view class="user-main">
      <view class="user-name">{{userView.name}}</view>
      <text class="user-account">{{userView.accountDisplay}}</text>
    </view>
    <view wx:if="{{userView.roleLabel}}" class="role-tag">{{userView.roleLabel}}</view>
  </view>

  <view wx:if="{{userView.storeName || userView.roleLabel}}">
    <view class="section-title profile-section-title">店铺与账号</view>
    <view class="card info-card">
      <view wx:if="{{userView.storeName}}" class="info-row"><text>店铺</text><text>{{userView.storeName}}</text></view>
      <view wx:if="{{userView.roleLabel}}" class="info-row"><text>身份</text><text>{{userView.roleLabel}}</text></view>
    </view>
  </view>

  <view class="section-title profile-section-title">数据与管理</view>
  <view class="card menu-list">
    <view class="menu-row sync-row">
      <view class="menu-copy"><view>数据同步</view><text>{{syncView.detail}}</text></view>
      <view class="sync-action">
        <text class="sync-label {{syncView.state}}">{{syncView.label}}</text>
        <button wx:if="{{syncView.canRetry}}" loading="{{syncing}}" catchtap="retrySync">重新同步</button>
      </view>
    </view>
    <view class="menu-row" bindtap="openOperations">
      <view class="menu-copy"><view>操作记录</view><text>查看商品库存变化</text></view><text class="chevron">›</text>
    </view>
  </view>

  <view class="section-title profile-section-title">管理</view>
  <view class="card menu-list">
    <view class="menu-row" bindtap="showAdminConsole">
      <view class="menu-copy"><view>管理后台</view><text>用于商品维护和系统管理</text></view><text class="chevron">›</text>
    </view>
  </view>

  <view class="section-title profile-section-title">系统</view>
  <view class="card menu-list">
    <view class="menu-row" bindtap="showAbout">
      <view class="menu-copy"><view>关于萍萍小助手</view></view><text class="chevron">›</text>
    </view>
    <view class="menu-row">
      <view class="menu-copy"><view>版本</view></view><text class="row-value">v{{version}}</text>
    </view>
  </view>

  <button class="logout-button" bindtap="logoutAccount">退出登录</button>
  <view class="version-note">萍萍小助手 v{{version}}</view>
</view>
