<view class="page profile-page">
  <view class="page-title">我的</view>

  <view class="user-card card" wx:if="{{userReady}}">
    <view class="store-eyebrow">我的门店</view>
    <view class="user-identity">
      <image wx:if="{{userView.hasAvatar}}" class="user-avatar" src="{{userView.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="user-avatar avatar-fallback">{{userView.avatarText}}</view>
      <view class="user-main">
        <view class="user-name">{{userView.storeName || '我的门店'}}</view>
        <text class="user-account">{{userView.roleLabel ? userView.roleLabel + '账号' : '经营账号'}}</text>
      </view>
    </view>
    <view class="identity-strip">
      <text>当前经营身份</text>
      <view class="identity-value">
        <text>{{userView.roleLabel || '经营者'}}</text>
        <view class="identity-dot"></view>
      </view>
    </view>
  </view>

  <view class="section-title profile-section-title">我的经营</view>
  <view class="card menu-list">
    <view class="menu-row sync-row">
      <view class="menu-icon">经</view>
      <view class="menu-copy">
        <view>经营数据</view>
        <text wx:if="{{syncView.state === 'synced'}}">经营记录已更新</text>
        <text wx:elif="{{syncView.state === 'pending'}}">正在保存经营记录</text>
        <text wx:elif="{{syncView.state === 'failed'}}">更新遇到问题，请稍后重试</text>
        <text wx:else>经营记录保持更新</text>
      </view>
      <view class="sync-action">
        <text wx:if="{{syncView.state === 'synced'}}" class="sync-label synced">已更新</text>
        <text wx:elif="{{syncView.state === 'pending'}}" class="sync-label pending">更新中</text>
        <text wx:elif="{{syncView.state === 'failed'}}" class="sync-label failed">更新失败</text>
        <text wx:else class="sync-label connected">正常</text>
        <button wx:if="{{syncView.canRetry}}" loading="{{syncing}}" catchtap="retrySync">重新更新</button>
      </view>
    </view>
    <view class="menu-row" bindtap="openOperations">
      <view class="menu-icon">记</view>
      <view class="menu-copy"><view>操作记录</view><text>看看最近的商品与库存变化</text></view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="section-title profile-section-title">门店管理</view>
  <view class="card menu-list">
    <view class="menu-row" bindtap="showAdminConsole">
      <view class="menu-icon">管</view>
      <view class="menu-copy"><view>管理后台</view><text>在电脑端维护商品与门店信息</text></view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="section-title profile-section-title">我的账号</view>
  <view class="card menu-list">
    <view class="menu-row" bindtap="showAbout">
      <view class="menu-icon">萍</view>
      <view class="menu-copy"><view>关于萍萍小助手</view><text>让商品、库存和经营记录更简单</text></view>
      <text class="chevron">›</text>
    </view>
    <view class="menu-row">
      <view class="menu-icon muted">版</view>
      <view class="menu-copy"><view>当前版本</view></view>
      <text class="row-value">v{{version}}</text>
    </view>
  </view>

  <button class="logout-button" bindtap="logoutAccount">退出当前账号</button>
  <view class="version-note">认真记好小店的每一笔经营</view>
</view>
