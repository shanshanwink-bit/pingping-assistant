.profile-page {
  padding-top: 16rpx;
  padding-bottom: calc(184rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.user-card {
  position: relative;
  padding: 30rpx 28rpx 0;
  border-color: #eadde1;
  background: linear-gradient(145deg, #fff 0%, #fdf8f9 100%);
  box-shadow: 0 12rpx 32rpx rgba(116, 42, 68, .06);
}

.store-eyebrow {
  margin-bottom: 22rpx;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.user-identity {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.user-avatar {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 auto;
  border: 4rpx solid #fff;
  border-radius: 28rpx;
  background: var(--color-brand-soft);
  box-shadow: 0 6rpx 18rpx rgba(116, 42, 68, .1);
}

.avatar-fallback {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: var(--color-brand);
  font-size: 34rpx;
  font-weight: 650;
}

.user-main { min-width: 0; flex: 1; }
.user-name { overflow: hidden; color: var(--color-text); font-size: 38rpx; font-weight: 650; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.user-account { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; }

.identity-strip {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(142, 54, 85, .1);
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.identity-value { display: flex; align-items: center; gap: 12rpx; color: var(--color-text); font-weight: 600; }
.identity-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--color-success); box-shadow: 0 0 0 6rpx rgba(71, 122, 98, .1); }

.profile-section-title {
  margin: 40rpx 4rpx 16rpx;
  font-size: 29rpx;
}

.menu-row {
  display: flex;
  min-height: 108rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-row:last-child { border-bottom: 0; }
.menu-row:active { background: var(--color-surface-muted); }

.menu-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: var(--color-brand);
  background: var(--color-brand-soft);
  font-size: 21rpx;
  font-weight: 650;
}

.menu-icon.muted { color: #8a7466; background: var(--color-accent-soft); }
.menu-copy { min-width: 0; flex: 1; }
.menu-copy view { color: var(--color-text); font-size: 28rpx; font-weight: 500; }
.menu-copy text { display: block; margin-top: 7rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.45; }
.chevron { color: #c5beb8; font-size: 38rpx; line-height: 1; }
.row-value { color: var(--color-text-secondary); font-size: 24rpx; }

.sync-action { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.sync-label { padding: 6rpx 14rpx; border-radius: 999rpx; color: var(--color-text-secondary); background: var(--color-surface-muted); font-size: 21rpx; }
.sync-label.synced,
.sync-label.connected { color: var(--color-success); background: #edf5f0; }
.sync-label.pending { color: var(--color-warning); background: #fbf1e5; }
.sync-label.failed { color: var(--color-danger); background: #faeaec; }
.sync-action button { height: 48rpx; margin: 0; padding: 0 14rpx; border: 1rpx solid var(--color-brand); border-radius: 12rpx; color: var(--color-brand); background: #fff; font-size: 21rpx; line-height: 46rpx; }

.logout-button {
  display: flex;
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0 0;
  padding: 0;
  border: 1rpx solid #ead6dc;
  border-radius: 22rpx;
  color: var(--color-brand);
  background: rgba(255, 255, 255, .78);
  font-size: 27rpx;
  line-height: 84rpx;
}

.logout-button:active { background: var(--color-brand-soft); }
.version-note { margin-top: 24rpx; color: var(--color-text-muted); text-align: center; font-size: 21rpx; }

@media (max-width: 340px) {
  .user-name { font-size: 34rpx; }
  .menu-row { padding-right: 20rpx; padding-left: 20rpx; }
  .menu-icon { width: 54rpx; height: 54rpx; }
}
