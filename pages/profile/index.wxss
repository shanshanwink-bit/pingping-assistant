.profile-page {
  padding-top: 16rpx;
  padding-bottom: calc(184rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--color-brand-soft);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-brand);
  font-size: 34rpx;
  font-weight: 600;
}

.user-main { flex: 1; min-width: 0; }
.user-name { overflow: hidden; color: var(--color-text); font-size: 34rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.user-account { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.role-tag { padding: 8rpx 16rpx; border-radius: 999rpx; color: var(--color-brand); background: var(--color-brand-soft); font-size: 22rpx; }

.profile-section-title {
  margin: 36rpx 4rpx 16rpx;
  font-size: 27rpx;
}

.info-row,
.menu-row {
  display: flex;
  min-height: 92rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 26rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.info-row:last-child,
.menu-row:last-child { border-bottom: 0; }
.info-row text:first-child { flex: 1; color: var(--color-text-secondary); }
.info-row text:last-child { color: var(--color-text); }
.menu-copy { flex: 1; min-width: 0; }
.menu-copy view { color: var(--color-text); font-size: 28rpx; }
.menu-copy text { display: block; margin-top: 7rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.45; }
.chevron { color: var(--color-text-muted); font-size: 38rpx; line-height: 1; }
.row-value { color: var(--color-text-secondary); font-size: 25rpx; }

.sync-action { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.sync-label { color: var(--color-text-secondary); font-size: 24rpx; }
.sync-label.synced { color: var(--color-success); }
.sync-label.pending { color: var(--color-warning); }
.sync-label.failed { color: var(--color-danger); }
.sync-action button { height: 48rpx; margin: 0; padding: 0 14rpx; border: 1rpx solid var(--color-brand); border-radius: 12rpx; color: var(--color-brand); background: #fff; font-size: 21rpx; line-height: 46rpx; }

.logout-button {
  height: 84rpx;
  margin-top: 40rpx;
  border: 1rpx solid #ead6dc;
  border-radius: 20rpx;
  color: var(--color-brand);
  background: #fff;
  font-size: 27rpx;
  line-height: 84rpx;
}

.version-note { margin-top: 24rpx; color: var(--color-text-muted); text-align: center; font-size: 21rpx; }
