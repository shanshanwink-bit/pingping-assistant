.form-page { padding-bottom: 80rpx; }
.quick-create-card { margin-bottom: 26rpx; padding: 28rpx 30rpx; border: 2rpx solid rgba(255,255,255,.88); border-radius: 28rpx; background: linear-gradient(135deg, rgba(218,241,255,.76), rgba(255,230,240,.68)); box-shadow: 0 14rpx 34rpx rgba(72,132,171,.09); }
.quick-create-step { display: inline-flex; padding: 6rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.7); color: #5a9bc5; font-size: 20rpx; }
.quick-create-title { margin-top: 14rpx; color: #294b64; font-size: 32rpx; font-weight: 650; }
.quick-create-card > text { display: block; margin-top: 8rpx; color: #7891a2; font-size: 22rpx; line-height: 1.65; }
.progressive-options { display: grid; gap: 16rpx; margin: 8rpx 0 28rpx; }
.progressive-option { display: flex; min-height: 92rpx; box-sizing: border-box; align-items: center; justify-content: space-between; padding: 18rpx 22rpx; border: 2rpx solid rgba(255,255,255,.8); border-radius: 24rpx; background: rgba(255,255,255,.5); box-shadow: 0 10rpx 26rpx rgba(74,128,165,.07); }
.progressive-option.active { border-color: rgba(111,187,231,.32); background: linear-gradient(135deg, rgba(224,244,255,.72), rgba(255,237,245,.62)); }
.progressive-option > view:first-child > view { color: #31536b; font-size: 25rpx; font-weight: 600; }
.progressive-option > view:first-child > text { display: block; margin-top: 5rpx; color: #8499a7; font-size: 19rpx; }
.progressive-action { padding: 8rpx 17rpx; border-radius: 999rpx; background: rgba(255,255,255,.74); color: #5c9ec8; font-size: 21rpx; }
.code-management-card { margin: 2rpx 0 24rpx; padding: 20rpx 22rpx 2rpx; border: 2rpx solid rgba(255,255,255,.82); border-radius: 24rpx; background: rgba(255,255,255,.48); }
.code-management-card.compact { padding-bottom: 20rpx; }
.code-management-card.compact .system-code-row { margin-bottom: 0; }
.system-code-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.system-code-row > view { display: flex; align-items: center; gap: 16rpx; }
.system-code-row > view > text { color: #718a9b; font-size: 21rpx; }
.system-code-row > view > view { color: #315b78; font-size: 27rpx; font-weight: 650; letter-spacing: 2rpx; }
.system-code-row > text { padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(218,240,255,.7); color: #6b9fbe; font-size: 18rpx; }
.item-number-field { margin-bottom: 20rpx; }
.optional-section-title { margin: 4rpx 0 22rpx; color: #31536b; font-size: 27rpx; font-weight: 650; }
.image-field { display: flex; flex-direction: column; align-items: center; margin-bottom: 36rpx; }
.photo-picker,
.photo-preview { width: 230rpx; height: 230rpx; border-radius: 30rpx; }
.photo-picker { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #d9aabe; background: #fdebf2; color: #8f7180; font-size: 23rpx; }
.camera-symbol { margin-bottom: 12rpx; color: #ca507f; font-size: 48rpx; }
.remove-photo { margin-top: 12rpx; color: #b83d32; font-size: 23rpx; }
.picker-value { display: flex; justify-content: space-between; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.spec-section { margin: 12rpx -4rpx 0; padding: 28rpx 24rpx 4rpx; border-radius: 28rpx; background: #fceaf1; }
.spec-title { margin-bottom: 24rpx; font-size: 30rpx; font-weight: 600; }
.preset-field { margin-bottom: 30rpx; }
.preset-group-label { margin: 4rpx 0 13rpx; color: #728b9c; font-size: 20rpx; }
.preset-group-label.number-label { margin-top: 20rpx; }
.preset-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.preset-chip { min-width: 84rpx; box-sizing: border-box; padding: 13rpx 18rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 18rpx; background: rgba(255,255,255,.62); color: #55778e; text-align: center; font-size: 22rpx; box-shadow: 0 6rpx 16rpx rgba(75,132,172,.05); }
.preset-chip.size-chip { min-width: 76rpx; }
.preset-chip.selected { border-color: rgba(91,170,220,.62); background: linear-gradient(135deg, #bfe5ff, #f5cddd); color: #285a7a; box-shadow: 0 8rpx 20rpx rgba(75,145,192,.13); font-weight: 600; }
.custom-spec-input { margin-top: 18rpx; background: rgba(255,255,255,.7); }
.supplier-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.supplier-chip { max-width: 100%; padding: 12rpx 18rpx; overflow: hidden; border: 2rpx solid rgba(255,255,255,.9); border-radius: 18rpx; background: rgba(255,255,255,.58); color: #5b788c; text-overflow: ellipsis; white-space: nowrap; font-size: 22rpx; }
.supplier-chip.selected { border-color: rgba(91,170,220,.6); background: linear-gradient(135deg, #c9eaff, #f8d6e3); color: #285a7a; font-weight: 600; }
.variant-stock-section { overflow: hidden; margin-bottom: 24rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 22rpx; background: rgba(255,255,255,.62); }
.variant-stock-head { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 22rpx; border-bottom: 1rpx solid rgba(112,158,189,.12); color: #29485f; font-size: 25rpx; font-weight: 600; }
.variant-stock-head text { color: #8097a6; font-size: 19rpx; font-weight: 400; }
.variant-stock-row { display: flex; align-items: center; justify-content: space-between; padding: 17rpx 22rpx; border-bottom: 1rpx solid rgba(112,158,189,.1); }
.variant-stock-row:last-child { border-bottom: 0; }
.variant-name { display: flex; align-items: center; gap: 11rpx; color: #365971; font-size: 24rpx; }
.variant-name text { padding: 5rpx 11rpx; border-radius: 999rpx; background: rgba(222,242,255,.75); color: #5795bb; font-size: 20rpx; }
.variant-stock-input { display: flex; width: 150rpx; height: 58rpx; box-sizing: border-box; align-items: center; padding: 0 15rpx; border: 1rpx solid rgba(255,255,255,.92); border-radius: 16rpx; background: rgba(255,255,255,.78); box-shadow: 0 7rpx 18rpx rgba(75,132,172,.07); }
.variant-stock-input input { flex: 1; min-width: 0; height: 58rpx; color: #29485f; text-align: right; font-size: 25rpx; }
.variant-stock-input text { margin-left: 8rpx; color: #7e94a3; font-size: 20rpx; }
.save-button { margin-top: 36rpx; }
.quick-default-spec { margin: 22rpx 0 0; padding: 20rpx 24rpx; border: 2rpx solid rgba(255,255,255,.82); border-radius: 22rpx; background: rgba(255,255,255,.52); }
.quick-default-spec view { color: #31536b; font-size: 23rpx; font-weight: 600; }
.quick-default-spec text { display: block; margin-top: 5rpx; color: #8096a5; font-size: 20rpx; }
