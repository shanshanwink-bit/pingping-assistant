<view class="page ai-page">
  <view class="ai-heading">
    <view class="page-title">AI商品助手</view>
    <view class="ai-subtitle">拍摄商品图片，快速识别商品信息。</view>
  </view>

  <view wx:if="{{featureChecking}}" class="ai-state-card">
    <view class="ai-loading"></view>
    <view>正在确认功能状态</view>
  </view>

  <view wx:elif="{{featureError}}" class="ai-state-card error-card">
    <view class="state-title">暂时无法使用</view>
    <view class="state-copy">{{featureError}}</view>
    <button class="outline-button" bindtap="checkFeature">重新检查</button>
  </view>

  <block wx:elif="{{featureEnabled}}">
    <view class="privacy-note">图片用于识别商品信息，价格和库存以门店数据为准。</view>

    <view class="image-card {{selectedImage ? 'has-image' : ''}}" bindtap="chooseImage">
      <image wx:if="{{selectedImage}}" class="image-preview" src="{{selectedImage}}" mode="aspectFit" />
      <view wx:else class="image-empty">
        <view class="camera-mark"></view>
        <view class="image-title">上传商品照片，快速查询信息</view>
        <view class="image-copy">支持拍照或选择图片</view>
      </view>
      <view wx:if="{{selectedImage}}" class="image-meta">点击更换图片 · {{selectedImageSize}}</view>
    </view>

    <button class="recognize-button" disabled="{{recognizing}}" loading="{{recognizing}}" bindtap="startRecognition">
      {{recognizing ? '正在识别并匹配商品…' : '拍照查商品'}}
    </button>

    <view wx:if="{{errorMessage}}" class="message-card error-message">{{errorMessage}}</view>

    <view wx:if="{{matchType}}" class="result-section">
      <view class="result-head">
        <view><view class="result-title">识别结果</view><view class="result-vision">{{visionSummary}}</view></view>
        <text wx:if="{{matchType === 'unique'}}">已匹配</text>
        <text wx:elif="{{matchType === 'candidates'}}">请选择</text>
      </view>

      <view wx:if="{{matchType === 'none'}}" class="message-card no-match">
        <view class="state-title">库存中没有找到匹配商品</view>
        <view class="state-copy">已识别到商品信息，可以更换角度或拍清包装文字后重试。</view>
      </view>

      <view wx:else class="candidate-list">
        <view class="candidate-card" wx:for="{{candidates}}" wx:key="id">
          <view class="candidate-top"><view><view class="candidate-identifiers"><text class="candidate-item-number">{{item.itemNumberText}}</text><text wx:if="{{item.internalCodeText}}" class="candidate-internal-code">{{item.internalCodeText}}</text></view><view class="candidate-name">{{item.name}}</view><view class="candidate-tags"><text>{{item.typeLabel}}</text><text>{{item.category}}</text></view></view><view class="candidate-price">{{item.salePriceText}}</view></view>
          <view class="candidate-spec">{{item.specText}}</view>
          <view class="candidate-metrics">
            <view><text>当前库存</text><view>{{item.stockText}} 件</view></view>
            <view><text>最近进货</text><view>{{item.recentPurchaseText}}</view></view>
            <view><text>最近进价</text><view>{{item.recentCostText}}</view></view>
          </view>
          <view wx:if="{{item.firstPurchaseText}}" class="first-purchase">首次进货 {{item.firstPurchaseText}}</view>
          <view wx:if="{{item.matchReasonText}}" class="match-reason">匹配依据：{{item.matchReasonText}}</view>
          <button class="detail-button" data-index="{{index}}" bindtap="openProduct">查看商品详情</button>
        </view>
      </view>
    </view>

    <view class="future-section">
      <view class="future-section-title">更多能力</view>
      <view class="future-capabilities" aria-label="更多商品管理能力">
        <view class="capability-card available" role="button" bindtap="openAiPurchase">
          <view class="capability-head">
            <view class="capability-title">拍照入库</view>
            <text class="capability-status available">可使用</text>
          </view>
          <view class="capability-copy">识别进货单，快速生成入库草稿</view>
        </view>
        <view class="capability-card" aria-disabled="true">
          <view class="capability-head">
            <view class="capability-title">快速盘点</view>
            <text class="capability-status planned">规划中</text>
          </view>
          <view class="capability-copy">拍照查看商品库存</view>
        </view>
      </view>
    </view>
  </block>
</view>
