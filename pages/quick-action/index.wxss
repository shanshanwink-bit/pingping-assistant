.quick-page { position: relative; overflow: hidden; padding: 30rpx 28rpx 190rpx; background: linear-gradient(160deg, rgba(231,246,255,.8), rgba(250,248,255,.68) 48%, rgba(255,238,245,.74)); }
.quick-mist { position: absolute; border-radius: 50%; filter: blur(24rpx); pointer-events: none; }
.mist-blue { top: 150rpx; left: -170rpx; width: 390rpx; height: 390rpx; background: rgba(104,195,241,.13); }
.mist-pink { top: 680rpx; right: -190rpx; width: 430rpx; height: 430rpx; background: rgba(239,139,179,.12); }
.quick-heading { position: relative; z-index: 1; padding: 9rpx 6rpx 25rpx; }
.quick-heading .page-title { margin: 0; color: #294b63; font-size: 44rpx; font-weight: 650; }
.quick-heading text { display: block; margin-top: 8rpx; color: #7892a3; font-size: 22rpx; }
.main-actions { display: grid; position: relative; z-index: 1; gap: 15rpx; }
.main-action { display: flex; min-height: 112rpx; align-items: center; gap: 18rpx; padding: 22rpx 24rpx; border: 2rpx solid rgba(255,255,255,.94); border-radius: 28rpx; background: rgba(255,255,255,.72); box-shadow: 0 15rpx 36rpx rgba(75,132,172,.1); }
.main-action-icon { display: flex; width: 70rpx; height: 70rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 23rpx; background: linear-gradient(145deg, #ccecff, #68b8eb); box-shadow: 0 10rpx 22rpx rgba(76,157,210,.19); }
.main-action.sale .main-action-icon { background: linear-gradient(145deg, #ffe0ec, #e982aa); box-shadow: 0 10rpx 22rpx rgba(219,107,150,.17); }
.main-action-icon image { width: 45rpx; height: 45rpx; }
.main-action > view:nth-child(2) { flex: 1; min-width: 0; }
.main-action > view:nth-child(2) > view { color: #31566f; font-size: 27rpx; font-weight: 650; }
.main-action > view:nth-child(2) > text { display: block; margin-top: 6rpx; color: #8198a7; font-size: 19rpx; }
.action-arrow { color: #8fa7b6; font-size: 36rpx; }
.other-action { display: flex; position: relative; z-index: 1; align-items: center; gap: 16rpx; margin-top: 16rpx; padding: 19rpx 22rpx; border: 2rpx solid rgba(255,255,255,.9); border-radius: 24rpx; background: rgba(255,255,255,.58); }
.other-icon { display: flex; width: 51rpx; height: 51rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 17rpx; background: linear-gradient(145deg, #eee8ff, #b19fe8); color: #fff; font-size: 22rpx; font-weight: 650; }
.other-action > view:nth-child(2) { flex: 1; }
.other-action > view:nth-child(2) > view { color: #47697e; font-size: 22rpx; font-weight: 600; }
.other-action > view:nth-child(2) > text { display: block; margin-top: 4rpx; color: #879aa7; font-size: 17rpx; }
.other-action > text { color: #91a7b5; font-size: 31rpx; }
.today-card { position: relative; z-index: 1; margin-top: 24rpx; padding: 22rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 28rpx; background: linear-gradient(135deg, rgba(255,255,255,.75), rgba(219,242,255,.66), rgba(255,230,240,.62)); box-shadow: 0 15rpx 36rpx rgba(75,132,172,.1); }
.today-head { display: flex; align-items: center; justify-content: space-between; color: #31566f; font-size: 25rpx; font-weight: 600; }
.today-head text { color: #7894a7; font-size: 19rpx; font-weight: 400; }
.today-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 18rpx; }
.today-grid > view { min-width: 0; padding: 4rpx 9rpx; text-align: center; }
.today-grid > view + view { border-left: 1rpx solid rgba(105,151,183,.14); }
.today-grid > view > text { color: #7c94a5; font-size: 17rpx; }
.today-grid > view > view { margin-top: 7rpx; overflow: hidden; color: #315f7d; font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.today-grid > view:nth-child(2) > view { color: #cd6b91; }
.today-grid > view > view text { font-size: 16rpx; font-weight: 400; }
