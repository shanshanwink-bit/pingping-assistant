<view class="page quick-page">
  <view class="quick-mist mist-blue"></view>
  <view class="quick-mist mist-pink"></view>

  <view class="quick-heading">
    <view class="page-title">今天记什么？</view>
    <text>选一件事，按提示填写就可以</text>
  </view>

  <view class="main-actions">
    <view class="main-action stock" bindtap="addStock">
      <view class="main-action-icon"><image src="/assets/icons/box-white.svg" mode="aspectFit" /></view>
      <view><view>拿货 / 加库存</view><text>新货到店，库存增加</text></view>
      <text class="action-arrow">›</text>
    </view>
    <view class="main-action sale" bindtap="addSale">
      <view class="main-action-icon"><image src="/assets/icons/bag-white.svg" mode="aspectFit" /></view>
      <view><view>卖货</view><text>记录卖了什么、收了多少钱</text></view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <view class="other-action" bindtap="addIncomeExpense">
    <view class="other-icon">¥</view>
    <view><view>记其他收入或支出</view><text>运费、包装费、线下收入等</text></view>
    <text>›</text>
  </view>

  <view class="today-card">
    <view class="today-head"><view>今天的情况</view><text bindtap="openRecords">看记录 ›</text></view>
    <view class="today-grid">
      <view><text>卖了多少钱</text><view>{{todaySaleText}}</view></view>
      <view><text>赚了多少</text><view>{{todayProfitText}}</view></view>
      <view><text>卖出</text><view>{{todaySaleQuantity}}<text> 件</text></view></view>
    </view>
  </view>
</view>
