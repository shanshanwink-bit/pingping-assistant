<view class="page product-page">
  <view class="product-heading">
    <view class="page-title">商品</view>
    <view class="product-subtitle">找商品、看库存，一眼就清楚</view>
  </view>

  <view wx:if="{{aiImageRecognition}}" class="ai-entry" bindtap="openAiRecognition">
    <view class="ai-entry-mark"><view></view></view>
    <view class="ai-entry-main"><view>AI商品助手</view><text>快速识别商品，查询库存和价格</text></view>
    <view class="ai-entry-arrow">›</view>
  </view>

  <view class="product-search">
    <view class="search-icon"></view>
    <input class="search-input" placeholder="搜索商品名称 / 货号" placeholder-class="search-placeholder" value="{{keyword}}" confirm-type="search" bindinput="onSearch" />
    <button wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">清除</button>
  </view>

  <view class="type-filter">
    <view wx:for="{{typeFilters}}" wx:key="value" class="type-filter-item {{activeType === item.value ? 'active' : ''}}" data-type="{{item.value}}" bindtap="selectType">{{item.label}}</view>
  </view>

  <view class="product-list-meta" wx:if="{{!isLoading && !loadFailed}}">
    <text>共 {{filteredProducts.length}} 款商品</text>
    <text wx:if="{{syncFailed}}" class="sync-note" bindtap="retryLoad">更新失败，点击重试</text>
  </view>

  <view wx:if="{{isLoading}}" class="state-card loading-state">
    <view class="loading-ring"></view>
    <view>正在加载商品</view>
  </view>

  <view wx:elif="{{loadFailed}}" class="state-card error-state">
    <view class="state-title">商品加载失败</view>
    <view class="state-copy">请稍后重试</view>
    <button class="state-button" loading="{{isRetrying}}" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:elif="{{filteredProducts.length}}" class="product-list">
    <view class="product-card" wx:for="{{filteredProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
      <image wx:if="{{item.displayImage}}" class="product-image" src="{{item.displayImage}}" mode="aspectFill" data-id="{{item.id}}" binderror="onProductImageError" />
      <view wx:else class="product-placeholder"><image src="{{item.placeholderIcon}}" mode="aspectFit" /></view>
      <view class="product-card-main">
        <view class="product-name">{{item.name}}</view>
        <view class="product-identity">
          <text>{{item.typeLabel}}</text>
          <text wx:if="{{item.identifier}}">货号 {{item.identifier}}</text>
          <text wx:else>货号未填写</text>
        </view>
        <view class="stock-status {{item.stockStatus.tone}}"><view class="status-dot"></view><text>{{item.stockStatus.label}}</text></view>
      </view>
      <view class="product-card-side">
        <view wx:if="{{!item.priceMissing}}" class="product-price">{{item.salePriceText}}</view>
        <view wx:else class="product-price missing">暂未设置售价</view>
        <view class="product-stock">库存 {{item.totalStockText}}件</view>
        <view class="product-arrow">›</view>
      </view>
    </view>
  </view>

  <view wx:else class="state-card empty-state">
    <image class="empty-icon" src="{{activeType === 'cosmetics' ? '/assets/icons/product-cosmetics.svg' : '/assets/icons/product-clothing.svg'}}" mode="aspectFit" />
    <view wx:if="{{emptyKind === 'search'}}">
      <view class="state-title">没有找到相关商品</view>
      <view class="state-copy">尝试更换名称或货号</view>
      <button class="state-button" bindtap="clearSearch">清除搜索</button>
    </view>
    <view wx:elif="{{emptyKind === 'category'}}">
      <view class="state-title">暂无{{activeType === 'cosmetics' ? '化妆品' : '服装'}}商品</view>
      <view class="state-copy">可以切换到“全部”查看其他商品</view>
    </view>
    <view wx:else>
      <view class="state-title">还没有商品</view>
      <view class="state-copy">商品可在管理后台创建</view>
    </view>
  </view>
</view>
