<view class="page inventory-page simple-products-page">
  <view class="clothing-orb orb-blue"></view>
  <view class="clothing-orb orb-pink"></view>

  <view class="simple-product-heading">
    <view><view class="page-title">商品</view><text>服装和化妆品都在这里</text></view>
    <button bindtap="addProduct">＋ 新建</button>
  </view>

  <view class="product-business-switch">
    <view wx:for="{{businessTabs}}" wx:key="value" class="product-business-item {{activeBusinessType === item.value ? 'active' : ''}}" data-type="{{item.value}}" bindtap="selectBusiness">{{item.label}}</view>
  </view>

  <view class="simple-stock-card {{activeBusinessType}}">
    <view class="simple-stock-main"><text>{{businessTitle}}还有</text><view>{{summary.totalStock}}<text> 件</text></view><text>{{summary.productCount}} 款商品</text></view>
    <view class="simple-stock-side"><image src="{{businessIcon}}" mode="aspectFit" /><text>剩余货值</text><view>{{stockValueText}}</view></view>
  </view>

  <view class="simple-record-actions">
    <view class="primary" bindtap="addSale"><text>卖货</text><view>记录收款 ›</view></view>
    <view bindtap="openStockRecords"><text>{{activeBusinessType === 'clothing' ? '拿货记录' : '库存记录'}}</text><view>查看变化 ›</view></view>
    <view bindtap="openSales"><text>卖货记录</text><view>查看明细 ›</view></view>
  </view>

  <view class="simple-stock-alert" wx:if="{{summary.lowSpecs.length}}" bindtap="openLowStock">
    <view><text>需要留意的库存</text><view>{{summary.lowSpecs.length}} 个规格库存不多或已缺货</view></view><text>查看 ›</text>
  </view>

  <view class="simple-search"><view class="search-lens"></view><input placeholder="搜索商品名称或货号" value="{{keyword}}" bindinput="onSearch" /></view>

  <scroll-view class="category-scroll simple-categories" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-row">
      <view wx:for="{{categories}}" wx:key="*this" class="category-chip {{activeCategory === item ? 'selected' : ''}}" data-category="{{item}}" bindtap="selectCategory">{{item}}</view>
    </view>
  </scroll-view>

  <view class="simple-list-head"><view>{{businessTitle}}商品</view><text>{{filteredProducts.length}} 款</text></view>
  <view class="clothing-product-stack" wx:if="{{filteredProducts.length}}">
    <view class="clothing-product-card simple-product-card" wx:for="{{filteredProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
      <image wx:if="{{item.image}}" class="clothing-product-image" src="{{item.image}}" mode="aspectFill" />
      <view wx:else class="clothing-product-placeholder"><image src="{{placeholderIcon}}" mode="aspectFit" /></view>
      <view class="clothing-product-main">
        <view class="clothing-product-name">{{item.name}}</view>
        <view class="clothing-product-meta">{{item.category}} · 编号 {{item.code}}<text wx:if="{{item.itemNumber}}"> · 货号 {{item.itemNumber}}</text></view>
        <view class="clothing-status {{item.stockStatus === '库存正常' ? 'normal' : 'warning'}}">{{item.stockStatus}}</view>
      </view>
      <view class="clothing-product-stock"><view><text>{{item.totalStock}}</text> 件</view><text class="card-arrow">›</text></view>
    </view>
  </view>

  <view wx:else class="clothing-empty">
    <view class="empty-hanger"><image src="{{placeholderIcon}}" mode="aspectFit" /></view>
    <view>{{products.length ? '没有找到这个商品' : '还没有商品'}}</view>
    <text>{{products.length ? '换个名称或分类试试' : '点击右上角新建商品'}}</text>
  </view>
</view>
