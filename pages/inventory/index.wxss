.product-page { min-height: 100vh; padding: 20rpx 32rpx calc(224rpx + env(safe-area-inset-bottom)); }
.product-heading { margin-bottom: 26rpx; }
.product-heading .page-title { margin: 0; font-size: 48rpx; line-height: 1.2; }
.product-subtitle { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; }

.product-search { display: flex; height: 88rpx; box-sizing: border-box; align-items: center; gap: 18rpx; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-surface); }
.search-icon { position: relative; width: 25rpx; height: 25rpx; flex: 0 0 auto; border: 3rpx solid var(--color-text-secondary); border-radius: 50%; }
.search-icon::after { position: absolute; right: -10rpx; bottom: -7rpx; width: 13rpx; height: 3rpx; border-radius: 3rpx; background: var(--color-text-secondary); content: ''; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 72rpx; color: var(--color-text); font-size: 27rpx; }
.search-placeholder { color: var(--color-text-muted); }
.search-clear { flex: 0 0 auto; height: 56rpx; margin: 0; padding: 0 6rpx; color: var(--color-brand); background: transparent; font-size: 24rpx; line-height: 56rpx; }

.type-filter { display: inline-flex; gap: 8rpx; margin-top: 20rpx; padding: 6rpx; border-radius: 999rpx; background: #eeeae6; }
.type-filter-item { min-width: 96rpx; padding: 12rpx 22rpx; border-radius: 999rpx; color: var(--color-text-secondary); text-align: center; font-size: 25rpx; }
.type-filter-item.active { color: var(--color-brand); background: var(--color-surface); font-weight: 600; }

.product-list-meta { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 4rpx 14rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.sync-note { color: var(--color-warning); }
.product-list { display: grid; gap: 14rpx; }
.product-card { display: flex; min-height: 148rpx; box-sizing: border-box; align-items: center; gap: 20rpx; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 28rpx; background: var(--color-surface); }
.product-card:active { background: var(--color-surface-muted); }
.product-image,
.product-placeholder { width: 112rpx; height: 112rpx; flex: 0 0 auto; border-radius: 22rpx; }
.product-image { display: block; background: var(--color-surface-muted); }
.product-placeholder { display: flex; align-items: center; justify-content: center; background: var(--color-brand-soft); }
.product-placeholder image { width: 58rpx; height: 58rpx; opacity: .82; }
.product-card-main { flex: 1; min-width: 0; }
.product-name { overflow: hidden; color: var(--color-text); font-size: 29rpx; font-weight: 600; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.product-identity { display: flex; min-width: 0; gap: 12rpx; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.product-identity text + text { overflow: hidden; padding-left: 12rpx; border-left: 1rpx solid var(--color-border); text-overflow: ellipsis; white-space: nowrap; }
.stock-status { display: inline-flex; align-items: center; gap: 8rpx; margin-top: 12rpx; font-size: 21rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; }
.stock-status.success { color: var(--color-success); }
.stock-status.warning { color: var(--color-warning); }
.stock-status.danger { color: var(--color-danger); }
.product-card-side { width: 172rpx; flex: 0 0 auto; text-align: right; }
.product-price { overflow: hidden; color: var(--color-brand); font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.product-price.missing { color: var(--color-text-muted); font-size: 20rpx; font-weight: 400; }
.product-stock { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.product-arrow { margin-top: 4rpx; color: var(--color-text-muted); font-size: 30rpx; }

.state-card { margin-top: 28rpx; padding: 78rpx 30rpx; border: 1rpx solid var(--color-border); border-radius: 28rpx; background: var(--color-surface); text-align: center; }
.loading-state { color: var(--color-text-secondary); }
.loading-ring { width: 38rpx; height: 38rpx; margin: 0 auto 20rpx; border: 4rpx solid var(--color-brand-soft); border-top-color: var(--color-brand); border-radius: 50%; animation: product-loading .8s linear infinite; }
.state-title { color: var(--color-text); font-size: 29rpx; font-weight: 600; }
.state-copy { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.state-button { display: inline-flex; height: 64rpx; align-items: center; justify-content: center; margin: 28rpx auto 0; padding: 0 30rpx; border: 1rpx solid var(--color-brand); border-radius: 18rpx; color: var(--color-brand); background: var(--color-surface); font-size: 24rpx; line-height: 64rpx; }
.empty-icon { width: 76rpx; height: 76rpx; margin-bottom: 22rpx; opacity: .65; }
@keyframes product-loading { to { transform: rotate(360deg); } }
@media (max-width: 340px) {
  .product-card { gap: 14rpx; padding: 18rpx; }
  .product-image,
  .product-placeholder { width: 96rpx; height: 96rpx; }
  .product-card-side { width: 150rpx; }
}
