.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 216rpx;
  padding-bottom: calc(216rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(216rpx + env(safe-area-inset-bottom));
  background: var(--color-canvas);
}

.home-nav {
  position: fixed;
  z-index: 50;
  top: 0;
  left: 0;
  width: 100%;
  box-sizing: content-box;
  border-bottom: 1rpx solid rgba(236, 232, 227, .72);
  background: rgba(247, 245, 242, .96);
}

.home-nav-content {
  display: flex;
  height: 100%;
  align-items: center;
  padding: 0 32rpx;
  color: var(--color-brand);
  font-size: 30rpx;
  font-weight: 650;
}

.home-greeting { padding: 26rpx 0 24rpx; }
.home-greeting-line { color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.4; }
.home-question { margin-top: 4rpx; color: var(--color-text); font-size: 44rpx; font-weight: 700; line-height: 1.28; }

.home-state-card,
.home-empty-card { border: 1rpx solid var(--color-border); border-radius: 32rpx; background: var(--color-surface); }
.home-state-card { display: flex; min-height: 280rpx; flex-direction: column; align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: 26rpx; }
.home-loading-dot { width: 22rpx; height: 22rpx; margin-bottom: 24rpx; border: 5rpx solid var(--color-brand-soft); border-top-color: var(--color-brand); border-radius: 50%; animation: home-loading 1s linear infinite; }
.home-error-state { padding: 36rpx; text-align: center; }
.home-state-title { color: var(--color-text); font-size: 30rpx; font-weight: 650; }
.home-state-detail { margin-top: 10rpx; font-size: 24rpx; }
.home-retry-button { display: flex; width: 220rpx; height: 80rpx; align-items: center; justify-content: center; margin-top: 28rpx; border-radius: 20rpx; color: #fff; background: var(--color-brand); font-size: 26rpx; }

.home-sync-notice { margin-bottom: 24rpx; padding: 20rpx 24rpx; border: 1rpx solid #efd9c1; border-radius: 24rpx; color: #8c5d2d; background: #fbf3e8; }
.home-sync-title { font-size: 25rpx; font-weight: 600; }
.home-sync-detail { display: block; margin-top: 5rpx; font-size: 21rpx; }

.home-business-card { overflow: hidden; padding: 28rpx 30rpx 26rpx; border-radius: 32rpx; color: #fff; background: var(--color-brand); }
.home-card-eyebrow { display: flex; align-items: center; justify-content: space-between; }
.home-eyebrow-label { font-size: 30rpx; font-weight: 650; }
.home-syncing-pill { padding: 6rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.14); font-size: 20rpx; }
.home-sales-label { margin-top: 22rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }
.home-sales-value { margin-top: 4rpx; overflow: hidden; font-size: 64rpx; font-weight: 700; letter-spacing: -2rpx; line-height: 1.16; text-overflow: ellipsis; white-space: nowrap; }
.home-sales-value.zero { font-size: 56rpx; }
.home-sales-value.compact { font-size: 58rpx; }
.home-sales-value.tight { font-size: 50rpx; }
.home-business-metrics { display: grid; grid-template-columns: 1fr 1fr; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.2); }
.home-metric { min-width: 0; }
.home-metric + .home-metric { padding-left: 30rpx; border-left: 1rpx solid rgba(255,255,255,.2); }
.home-metric-label { color: rgba(255,255,255,.68); font-size: 22rpx; }
.home-metric-value { margin-top: 8rpx; overflow: hidden; font-size: 32rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.home-metric-unit { margin-left: 4rpx; font-size: 21rpx; font-weight: 400; }
.home-no-sales { margin-top: 16rpx; color: rgba(255,255,255,.76); font-size: 22rpx; }

.home-section { margin-top: 40rpx; }
.home-section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.home-section-title { color: var(--color-text); font-size: 36rpx; font-weight: 650; }
.home-section-more { color: var(--color-brand); font-size: 24rpx; }
.home-section-link:active { opacity: .65; }

.home-quick-actions,
.home-stock-card { display: flex; overflow: hidden; border: 1rpx solid var(--color-border); border-radius: 32rpx; background: var(--color-surface); }
.home-quick-button { display: flex; min-width: 0; height: 148rpx; flex: 1; flex-direction: column; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 0; color: var(--color-text); background: transparent; font-size: 26rpx; line-height: 1.2; }
.home-quick-button + .home-quick-button { border-left: 1rpx solid var(--color-border); }
.home-quick-button:active { background: var(--color-surface-muted); }
.home-action-label { margin-top: 14rpx; font-weight: 600; }
.home-action-icon { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-brand); background: var(--color-brand-soft); font-size: 23rpx; font-weight: 650; }
.home-action-image { width: 38rpx; height: 38rpx; }

.home-list-card { overflow: hidden; border: 1rpx solid var(--color-border); border-radius: 32rpx; background: var(--color-surface); }
.home-alert-row,
.home-record-row { display: flex; min-height: 104rpx; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; }
.home-alert-row + .home-alert-row,
.home-record-row + .home-record-row { border-top: 1rpx solid var(--color-border); }
.home-alert-row:active { background: var(--color-surface-muted); }
.home-alert-marker,
.home-record-icon { display: flex; width: 58rpx; height: 58rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 50%; color: var(--color-warning); background: #fbf1e5; font-size: 21rpx; font-weight: 650; }
.home-alert-marker.danger { color: var(--color-danger); background: #faeaec; }
.home-alert-marker.expiry { color: #9b723e; background: var(--color-accent-soft); }
.home-row-main { min-width: 0; flex: 1; }
.home-row-title { overflow: hidden; color: var(--color-text); font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.home-row-spec { color: var(--color-text-secondary); font-size: 22rpx; font-weight: 400; }
.home-row-detail { display: block; margin-top: 7rpx; overflow: hidden; color: var(--color-text-secondary); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.home-alert-type { flex: 0 0 auto; color: var(--color-warning); font-size: 21rpx; }
.home-alert-type.danger { color: var(--color-danger); }
.home-alert-type.expiry { color: #9b723e; }

.home-empty-card { padding: 36rpx 28rpx; text-align: center; }
.home-empty-title { color: var(--color-success); font-size: 27rpx; font-weight: 600; }
.home-empty-detail { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.home-stock-item { min-width: 0; flex: 1; padding: 30rpx 12rpx; text-align: center; }
.home-stock-item + .home-stock-item { border-left: 1rpx solid var(--color-border); }
.home-stock-label { color: var(--color-text-secondary); font-size: 21rpx; }
.home-stock-value { margin-top: 12rpx; overflow: hidden; color: var(--color-text); font-size: 28rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.home-stock-unit { margin-left: 3rpx; font-size: 19rpx; font-weight: 400; }

.home-record-icon.sale,
.home-record-icon.income { color: var(--color-success); background: #eaf3ee; }
.home-record-icon.purchase { color: #9b723e; background: var(--color-accent-soft); }
.home-record-icon.expense { color: var(--color-danger); background: #faeaec; }
.home-record-icon.stock { color: var(--color-brand); background: var(--color-brand-soft); }
.home-record-side { max-width: 190rpx; flex: 0 0 auto; text-align: right; }
.home-record-value { overflow: hidden; color: var(--color-text); font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.home-record-side.sale .home-record-value,
.home-record-side.income .home-record-value { color: var(--color-success); }
.home-record-side.expense .home-record-value { color: var(--color-danger); }
.home-record-time { display: block; margin-top: 6rpx; color: var(--color-text-muted); font-size: 18rpx; }
.home-record-empty .home-empty-title { color: var(--color-text); }

@keyframes home-loading { to { transform: rotate(360deg); } }

@media (max-width: 340px) {
  .home-question { font-size: 42rpx; }
  .home-sales-value { font-size: 58rpx; }
  .home-sales-value.compact { font-size: 50rpx; }
  .home-sales-value.tight { font-size: 44rpx; }
  .home-alert-type { display: none; }
  .home-stock-item { padding-right: 7rpx; padding-left: 7rpx; }
  .home-stock-value { font-size: 25rpx; }
}
