.stock-overview-page { padding-top: 18rpx; padding-bottom: 70rpx; }
.overview-heading .page-title { margin-bottom: 4rpx; }
.overview-heading > text { color: #7892a4; font-size: 23rpx; }
.business-filter { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin: 28rpx 0 22rpx; padding: 7rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 22rpx; background: rgba(255,255,255,.56); box-shadow: 0 10rpx 28rpx rgba(74,123,158,.08); }
.business-filter-item { padding: 15rpx 8rpx; border-radius: 16rpx; color: #718b9d; text-align: center; font-size: 24rpx; }
.business-filter-item.active { background: linear-gradient(135deg, #def2ff, #ffe3ee); color: #438fb9; font-weight: 600; box-shadow: 0 7rpx 18rpx rgba(74,132,173,.1); }
.result-summary { margin: 0 4rpx 14rpx; color: #7d94a4; font-size: 23rpx; }
.overview-row { display: flex; gap: 18rpx; align-items: center; padding: 22rpx; border-bottom: 1rpx solid rgba(104,151,183,.11); }
.overview-row:last-child { border-bottom: 0; }
.overview-image,
.overview-placeholder { width: 92rpx; height: 92rpx; flex: 0 0 auto; border-radius: 22rpx; }
.overview-image { display: block; }
.overview-placeholder { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #e1f3ff, #e9eeff); color: #559bca; font-size: 27rpx; font-weight: 600; }
.overview-placeholder.cosmetics { background: linear-gradient(145deg, #ffe5f0, #e9f2ff); color: #d36f99; }
.overview-main { flex: 1; min-width: 0; }
.overview-name { overflow: hidden; color: #29485f; font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.overview-detail { margin-top: 7rpx; overflow: hidden; color: #7d94a4; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.overview-tags { display: flex; gap: 9rpx; margin-top: 9rpx; }
.overview-tags text { padding: 4rpx 10rpx; border-radius: 999rpx; background: rgba(216,240,255,.68); color: #5596bd; font-size: 18rpx; }
.overview-tags .status { background: rgba(255,239,214,.72); color: #c68024; }
.overview-tags .status.out { background: rgba(255,225,235,.74); color: #d4678e; }
.overview-stock { flex: 0 0 auto; color: #7890a1; text-align: right; font-size: 21rpx; }
.overview-stock > text { color: #3e91c4; font-size: 30rpx; font-weight: 650; }
.overview-stock view { display: inline; margin-left: 9rpx; color: #a4b5c0; font-size: 31rpx; }
.overview-empty { margin-top: 18rpx; border-radius: 26rpx; background: rgba(255,255,255,.58); }
