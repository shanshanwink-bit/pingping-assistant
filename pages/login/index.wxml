<view class="login-page">
  <view class="page-glow page-glow-top"></view>
  <view class="page-glow page-glow-bottom"></view>
  <view class="login-safe" style="height: {{statusBarHeight}}px;"></view>

  <view class="login-content">
    <view class="login-hero">
      <view class="brand-mark">
        <image class="brand-logo" src="/assets/icons/login-store-management.png" mode="aspectFit" />
      </view>
      <view class="hero-title">萍萍小助手</view>
      <text class="hero-subtitle">让门店经营更简单</text>

      <text class="feature-summary">商品管理 · 库存管理 · 销售记录 · 经营分析</text>
    </view>

    <view class="login-card">
      <view class="card-title">{{restoring ? '正在同步店铺' : '进入萍萍小助手'}}</view>
      <text class="card-description">{{restoring ? '正在读取服务器上的经营数据' : '登录后，轻松管理你的门店'}}</text>

      <button class="login-button {{submitting || demoSubmitting || restoring ? 'is-disabled' : ''}}" loading="{{submitting || restoring}}" disabled="{{submitting || demoSubmitting || restoring}}" bindtap="submitWechatLogin">
        <text>{{restoring ? '正在同步服务器数据' : '微信登录'}}</text>
      </button>

      <button class="experience-button {{submitting || demoSubmitting || restoring ? 'is-disabled' : ''}}" loading="{{demoSubmitting}}" disabled="{{submitting || demoSubmitting || restoring}}" bindtap="submitDemoLogin">{{demoSubmitting ? '正在进入体验店' : '体验一下'}}</button>

      <view class="login-error" wx:if="{{errorText}}">{{errorText}}</view>
      <view class="offline-actions" wx:if="{{offlineAvailable}}">
        <button class="offline-action sync-action" bindtap="retrySync">重新同步</button>
        <button class="offline-action" bindtap="enterOffline">暂不登录，使用本机缓存</button>
      </view>
    </view>

    <view class="security-note">
      <view class="note-dot"></view>
      <text>今天的经营，从这里开始</text>
    </view>
  </view>
</view>
