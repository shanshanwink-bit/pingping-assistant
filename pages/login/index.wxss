.login-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0 46rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fdf8e9 0%, #fcf8ec 72%, #f1f5ed 100%);
  color: #24443a;
}

.login-safe {
  position: relative;
  z-index: 1;
}

.login-hero {
  display: flex;
  position: relative;
  z-index: 1;
  flex-direction: column;
  align-items: center;
  margin-top: 62rpx;
  text-align: center;
}

.avatar-picker {
  display: flex;
  width: 118rpx;
  height: 118rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

.avatar-picker::after,
.login-button::after,
.offline-actions button::after {
  border: 0;
}

.avatar-picker > image,
.avatar-fallback {
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  border-radius: 50%;
}

.avatar-picker > image {
  display: block;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.avatar-fallback image {
  width: 58rpx;
  height: 58rpx;
  filter: saturate(.75) brightness(1.18);
}

.hero-eyebrow {
  margin-top: 38rpx;
  color: #557568;
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 7rpx;
  line-height: 1.3;
}

.hero-title {
  margin-top: 22rpx;
  color: #203f35;
  font-size: 51rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 24rpx;
  color: #7a837c;
  font-size: 22rpx;
  line-height: 1.6;
}

.login-card {
  position: relative;
  z-index: 1;
  margin-top: 72rpx;
  padding: 46rpx 38rpx 38rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 28rpx 52rpx rgba(50, 70, 56, .09);
  text-align: center;
}

.card-title {
  color: #23453a;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.card-description {
  display: block;
  max-width: 530rpx;
  margin: 23rpx auto 0;
  color: #858a84;
  font-size: 20rpx;
  line-height: 1.65;
}

.nickname-field {
  display: flex;
  height: 78rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 22rpx;
  margin-top: 30rpx;
  padding: 0 26rpx;
  border: 2rpx solid #ece9df;
  border-radius: 22rpx;
  background: #fffdf8;
  text-align: left;
}

.nickname-field > text {
  flex: 0 0 auto;
  color: #9b9b90;
  font-size: 20rpx;
}

.nickname-field input {
  flex: 1;
  min-width: 0;
  color: #294b40;
  font-size: 22rpx;
}

.login-button {
  display: flex;
  width: 100%;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 28rpx 0 0;
  border-radius: 27rpx;
  background: #3f735f;
  color: #fff;
  box-shadow: 0 18rpx 30rpx rgba(52, 103, 83, .18);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.login-button[disabled] {
  background: #739486;
  color: rgba(255, 255, 255, .8);
}

.wechat-mark {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  background: #fff;
  color: #3f735f;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.login-error {
  margin-top: 20rpx;
  color: #b45f48;
  font-size: 20rpx;
  line-height: 1.4;
}

.offline-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 13rpx;
}

.offline-actions button {
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  background: transparent;
  color: #7d847d;
  font-size: 19rpx;
  line-height: 52rpx;
}

.offline-actions button:first-child {
  color: #4d7465;
}

.login-note {
  display: block;
  position: relative;
  z-index: 1;
  margin: 39rpx 36rpx 0;
  color: #989b94;
  font-size: 17rpx;
  line-height: 1.6;
  text-align: center;
}

@media (max-height: 700px) {
  .login-hero {
    margin-top: 34rpx;
  }

  .login-card {
    margin-top: 46rpx;
  }
}
