.login-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0 44rpx calc(42rpx + env(safe-area-inset-bottom));
  background: #fbf6ed;
  color: #30272a;
}

.page-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.page-glow-top {
  top: -190rpx;
  right: -220rpx;
  width: 560rpx;
  height: 560rpx;
  background: rgba(142, 54, 85, .07);
}

.page-glow-bottom {
  bottom: -260rpx;
  left: -250rpx;
  width: 620rpx;
  height: 620rpx;
  border: 1rpx solid rgba(142, 54, 85, .08);
}

.login-safe,
.login-content {
  position: relative;
  z-index: 1;
}

.login-content {
  display: flex;
  min-height: calc(100vh - 90rpx - env(safe-area-inset-bottom));
  flex-direction: column;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 42rpx;
  text-align: center;
}

.brand-mark {
  display: flex;
  width: 156rpx;
  height: 156rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
}

.brand-logo {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-title {
  margin-top: 40rpx;
  color: #4a2834;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 22rpx;
  color: #8c7e82;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  line-height: 1.6;
}

.feature-summary {
  display: block;
  margin-top: 36rpx;
  color: #755d66;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.login-card {
  position: relative;
  margin-top: 104rpx;
  padding: 38rpx 34rpx 34rpx;
  border: 1rpx solid rgba(142, 54, 85, .08);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 26rpx 64rpx rgba(81, 54, 62, .10);
  text-align: center;
}

.card-title {
  color: #4b343c;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.card-description {
  display: block;
  margin-top: 13rpx;
  color: #9a8c90;
  font-size: 20rpx;
  line-height: 1.55;
}

.login-button::after,
.experience-button::after,
.offline-action::after {
  border: 0;
}

.login-button,
.experience-button {
  display: flex;
  width: 100% !important;
  min-width: 100%;
  max-width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  max-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-right: 0;
  margin-left: 0;
  padding: 0;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1;
}

.login-button {
  margin: 34rpx 0 0;
  border-color: #8e3655;
  background: #8e3655;
  color: #fff;
  box-shadow: 0 16rpx 30rpx rgba(142, 54, 85, .20);
}

.login-button.is-disabled {
  background: #b17b8e;
  color: rgba(255, 255, 255, .82);
}

.experience-button {
  margin-top: 18rpx;
  border-color: #8e3655;
  background: #fff;
  color: #8e3655;
}

.experience-button.is-disabled {
  border-color: #c9a8b4;
  color: #a77c8c;
}

.login-error {
  margin-top: 20rpx;
  color: #b24f4f;
  font-size: 20rpx;
  line-height: 1.4;
}

.offline-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 13rpx;
}

.offline-action {
  height: 52rpx;
  margin: 0;
  padding: 0 18rpx;
  background: transparent;
  color: #8f7f84;
  font-size: 19rpx;
  line-height: 52rpx;
}

.sync-action {
  color: #8e3655;
}

.security-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: auto 20rpx 0;
  padding-top: 32rpx;
  color: #a09196;
  font-size: 18rpx;
  line-height: 1.5;
  text-align: center;
}

.note-dot {
  width: 8rpx;
  height: 8rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #8e3655;
  opacity: .55;
}

@media (max-height: 700px) {
  .login-hero {
    margin-top: 22rpx;
  }

  .hero-title {
    margin-top: 30rpx;
    font-size: 46rpx;
  }

  .hero-subtitle {
    margin-top: 18rpx;
  }

  .feature-summary {
    margin-top: 28rpx;
  }

  .login-card {
    margin-top: 72rpx;
    padding-top: 30rpx;
  }
}
