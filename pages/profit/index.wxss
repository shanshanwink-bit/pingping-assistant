.ledger-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 32rpx 216rpx;
  padding-bottom: calc(216rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(216rpx + env(safe-area-inset-bottom));
  background: var(--color-canvas);
}

.ledger-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.ledger-heading-copy { min-width: 0; }
.ledger-title { margin: 0; }
.ledger-subtitle { display: block; margin-top: 6rpx; color: var(--color-text-secondary); font-size: 24rpx; }

.ledger-entry-button {
  display: flex;
  width: 132rpx;
  height: 66rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-brand);
  border-radius: 18rpx;
  color: var(--color-brand);
  background: var(--color-surface);
  font-size: 24rpx;
  line-height: 1;
}

.ledger-periods {
  display: inline-flex;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
  background: var(--color-surface);
}

.ledger-period {
  min-width: 112rpx;
  padding: 14rpx 18rpx;
  border-radius: 15rpx;
  color: var(--color-text-secondary);
  text-align: center;
  font-size: 23rpx;
}

.ledger-period.active { color: var(--color-brand); background: var(--color-brand-soft); font-weight: 600; }

.ledger-summary-card {
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  background: var(--color-surface);
}

.ledger-summary-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 26rpx 18rpx; }
.ledger-summary-label { color: var(--color-text); font-size: 27rpx; font-weight: 600; }
.ledger-range { color: var(--color-text-secondary); font-size: 20rpx; }
.ledger-summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.ledger-metric { min-width: 0; padding: 25rpx 14rpx 27rpx; text-align: center; }
.ledger-metric + .ledger-metric { border-left: 1rpx solid var(--color-border); }
.ledger-metric-label { color: var(--color-text-secondary); font-size: 21rpx; }
.ledger-metric-value { margin-top: 10rpx; overflow: hidden; color: var(--color-text); font-size: 29rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.ledger-metric.profit { background: var(--color-brand-soft); }
.ledger-metric.profit .ledger-metric-label,
.ledger-metric.profit .ledger-metric-value { color: var(--color-brand); }
.ledger-profit-note { padding: 18rpx 24rpx; color: var(--color-text-secondary); font-size: 20rpx; line-height: 1.5; }

.ledger-quantity-strip { display: grid; grid-template-columns: 1fr 1rpx 1fr; margin-top: 14rpx; padding: 20rpx 24rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-surface); }
.ledger-quantity-item { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.ledger-quantity-label { color: var(--color-text-secondary); font-size: 21rpx; }
.ledger-quantity-value { color: var(--color-text); font-size: 24rpx; font-weight: 600; }
.ledger-quantity-divider { background: var(--color-border); }

.ledger-warning { margin-top: 14rpx; padding: 16rpx 20rpx; border: 1rpx solid #efdcbf; border-radius: 18rpx; color: var(--color-warning); background: #fbf5eb; font-size: 21rpx; line-height: 1.5; }

.ledger-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-top: 40rpx; }
.ledger-section-title { color: var(--color-text); font-size: 31rpx; font-weight: 650; }
.ledger-section-subtitle { display: block; margin-top: 5rpx; color: var(--color-text-secondary); font-size: 20rpx; }
.ledger-flow-types { display: flex; gap: 4rpx; padding: 4rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-surface); }
.ledger-flow-type { padding: 10rpx 14rpx; border-radius: 12rpx; color: var(--color-text-secondary); font-size: 20rpx; }
.ledger-flow-type.active { color: var(--color-brand); background: var(--color-brand-soft); }

.ledger-records-card { margin-top: 16rpx; padding: 0 24rpx; border: 1rpx solid var(--color-border); border-radius: 28rpx; background: var(--color-surface); }
.ledger-record { display: flex; min-height: 122rpx; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--color-border); }
.ledger-record:last-child { border-bottom: 0; }
.ledger-record-mark { display: flex; width: 54rpx; height: 54rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 17rpx; color: var(--color-brand); background: var(--color-brand-soft); font-size: 21rpx; font-weight: 650; }
.ledger-record-mark.purchase,
.ledger-record-mark.expense { color: var(--color-warning); background: #fbf0e4; }
.ledger-record-mark.income { color: var(--color-success); background: #eaf3ee; }
.ledger-record-main { flex: 1; min-width: 0; }
.ledger-record-type { color: var(--color-text-secondary); font-size: 19rpx; }
.ledger-record-title { margin-top: 4rpx; overflow: hidden; color: var(--color-text); font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.ledger-record-meta,
.ledger-record-time { display: block; margin-top: 5rpx; overflow: hidden; color: var(--color-text-secondary); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.ledger-record-time { color: var(--color-text-muted); }
.ledger-record-amount { flex: 0 0 auto; max-width: 190rpx; overflow: hidden; font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.ledger-record-amount.income { color: var(--color-success); }
.ledger-record-amount.expense { color: var(--color-danger); }
.ledger-record-amount.missing { color: var(--color-text-secondary); font-size: 21rpx; font-weight: 400; }

.ledger-empty-card,
.ledger-state-card { margin-top: 16rpx; padding: 66rpx 28rpx; border: 1rpx solid var(--color-border); border-radius: 28rpx; background: var(--color-surface); text-align: center; }
.ledger-empty-mark { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; margin: 0 auto 18rpx; border-radius: 21rpx; color: var(--color-brand); background: var(--color-brand-soft); font-size: 25rpx; font-weight: 650; }
.ledger-empty-title,
.ledger-state-title { color: var(--color-text); font-size: 27rpx; font-weight: 600; }
.ledger-empty-text,
.ledger-state-text { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.ledger-empty-action,
.ledger-retry-button { width: 188rpx; height: 70rpx; margin: 24rpx auto 0; border-radius: 17rpx; color: #fff; background: var(--color-brand); font-size: 23rpx; line-height: 70rpx; }
button.ledger-empty-action { display: flex; width: auto; height: 80rpx; box-sizing: border-box; align-items: center; justify-content: center; margin: 28rpx 0 0; padding: 0 24rpx; border-radius: 20rpx; line-height: 1; }
.ledger-loading-ring { width: 38rpx; height: 38rpx; margin: 0 auto 20rpx; border: 4rpx solid var(--color-brand-soft); border-top-color: var(--color-brand); border-radius: 50%; animation: ledger-loading .8s linear infinite; }

@keyframes ledger-loading { to { transform: rotate(360deg); } }

@media (max-width: 340px) {
  .ledger-heading { align-items: flex-start; }
  .ledger-summary-grid { grid-template-columns: 1fr; }
  .ledger-metric + .ledger-metric { border-top: 1rpx solid var(--color-border); border-left: 0; }
  .ledger-section-head { align-items: flex-start; flex-direction: column; }
  .ledger-record-amount { max-width: 150rpx; font-size: 22rpx; }
}
