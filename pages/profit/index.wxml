<view class="page ledger-page">
  <view class="ledger-heading">
    <view class="ledger-heading-copy">
      <view class="page-title ledger-title">账本</view>
      <text class="ledger-subtitle">看收入、支出和盈利</text>
    </view>
    <button class="ledger-entry-button" bindtap="goManualEntry">记一笔</button>
  </view>

  <view wx:if="{{isLoading}}" class="ledger-state-card">
    <view class="ledger-loading-ring"></view>
    <view class="ledger-state-title">正在加载账本</view>
    <text class="ledger-state-text">请稍候</text>
  </view>

  <view wx:elif="{{loadFailed}}" class="ledger-state-card">
    <view class="ledger-state-title">账本加载失败</view>
    <text class="ledger-state-text">请稍后重试</text>
    <button class="ledger-retry-button" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <view class="ledger-periods" aria-label="时间范围">
      <view
        wx:for="{{periods}}"
        wx:key="value"
        class="ledger-period {{activePeriod === item.value ? 'active' : ''}}"
        data-period="{{item.value}}"
        bindtap="selectPeriod"
      >{{item.label}}</view>
    </view>

    <view class="ledger-summary-card">
      <view class="ledger-summary-head">
        <text class="ledger-summary-label">经营概览</text>
        <text class="ledger-range">{{periodRangeText}}</text>
      </view>
      <view class="ledger-summary-grid">
        <view class="ledger-metric">
          <text class="ledger-metric-label">收入</text>
          <view class="ledger-metric-value">{{summaryText.income}}</view>
        </view>
        <view class="ledger-metric">
          <text class="ledger-metric-label">支出</text>
          <view class="ledger-metric-value">{{summaryText.expense}}</view>
        </view>
        <view class="ledger-metric profit">
          <text class="ledger-metric-label">盈利</text>
          <view class="ledger-metric-value">{{summaryText.profit}}</view>
        </view>
      </view>
      <view class="ledger-profit-note">盈利按销售毛利，加上其他收入并扣除其他支出</view>
    </view>

    <view class="ledger-quantity-strip">
      <view class="ledger-quantity-item">
        <text class="ledger-quantity-label">卖出</text>
        <view class="ledger-quantity-value">{{summaryText.saleQuantity}} 件</view>
      </view>
      <view class="ledger-quantity-divider"></view>
      <view class="ledger-quantity-item">
        <text class="ledger-quantity-label">拿货</text>
        <view class="ledger-quantity-value">{{summaryText.purchaseQuantity}} 件</view>
      </view>
    </view>

    <view wx:if="{{summary.unpricedCount}}" class="ledger-warning">
      {{summary.unpricedCount}} 笔销售缺少真实成本，暂未计入盈利
    </view>

    <view class="ledger-section-head">
      <view>
        <view class="ledger-section-title">经营流水</view>
        <text class="ledger-section-subtitle">{{totalRecordCount}} 条记录，按时间倒序</text>
      </view>
      <view class="ledger-flow-types">
        <view
          wx:for="{{flowTypes}}"
          wx:key="value"
          class="ledger-flow-type {{activeFlowType === item.value ? 'active' : ''}}"
          data-type="{{item.value}}"
          bindtap="selectFlowType"
        >{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{records.length}}" class="ledger-records-card">
      <view class="ledger-record" wx:for="{{records}}" wx:key="key">
        <view class="ledger-record-mark {{item.typeClass}}">{{item.shortLabel}}</view>
        <view class="ledger-record-main">
          <text class="ledger-record-type">{{item.typeLabel}}</text>
          <view class="ledger-record-title">{{item.title}}</view>
          <text wx:if="{{item.metaText}}" class="ledger-record-meta">{{item.metaText}}</text>
          <text class="ledger-record-time">{{item.timeText}}</text>
        </view>
        <text class="ledger-record-amount {{item.amountClass}}">{{item.amountText}}</text>
      </view>
    </view>

    <view wx:else class="ledger-empty-card">
      <view class="ledger-empty-mark">账</view>
      <view class="ledger-empty-title">{{emptyTitle}}</view>
      <text class="ledger-empty-text">{{emptyDescription}}</text>
      <button class="ledger-empty-action" bindtap="goManualEntry">记一笔</button>
    </view>
  </block>
</view>
