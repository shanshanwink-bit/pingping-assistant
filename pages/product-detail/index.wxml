<view class="page product-detail-page">
  <view wx:if="{{isLoading}}" class="detail-state-card">
    <view class="detail-loading-ring"></view>
    <view>正在加载商品详情</view>
  </view>

  <view wx:elif="{{loadError}}" class="detail-state-card">
    <view class="detail-state-title">商品详情加载失败</view>
    <view class="detail-state-copy">请稍后重试</view>
    <button class="detail-retry" loading="{{isRefreshing}}" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:elif="{{product}}">
    <view class="detail-head-card">
      <image wx:if="{{product.displayImage}}" class="detail-image" src="{{product.displayImage}}" mode="aspectFill" binderror="onImageError" />
      <view wx:else class="detail-placeholder"><image src="{{product.placeholderIcon}}" mode="aspectFit" /></view>
      <view class="detail-head-main">
        <view class="detail-name">{{product.name}}</view>
        <view class="detail-tags"><text>{{product.typeLabel}}</text><text>{{product.category}}</text></view>
        <view class="detail-identifier">{{product.identifier ? '货号 ' + product.identifier : '货号未填写'}}</view>
        <view wx:if="{{!product.isActive}}" class="detail-inactive-badge">已停用</view>
        <view class="detail-stock-status {{product.stockStatus.tone}}"><view></view><text>{{product.stockStatus.label}}</text></view>
      </view>
    </view>

    <view class="detail-section-title">经营数据</view>
    <view class="metric-grid">
      <view class="metric-item"><text>售价</text><view class="{{product.salePriceText === '暂未设置' ? 'missing' : ''}}">{{product.salePriceText}}</view></view>
      <view class="metric-item"><text>进价</text><view class="{{product.costPriceText === '暂未设置' ? 'missing' : ''}}">{{product.costPriceText}}</view></view>
      <view class="metric-item"><text>单件毛利</text><view class="{{product.marginText === '暂无法计算' ? 'missing' : ''}}">{{product.marginText}}</view></view>
      <view class="metric-item total-stock"><text>总库存</text><view>{{product.totalStockText}}<text>件</text></view></view>
    </view>

    <block wx:if="{{product.businessType === 'clothing'}}">
      <view class="detail-section-head">
        <view class="detail-section-title">规格库存</view>
        <text>{{product.specCountText}} 个规格</text>
      </view>

      <scroll-view wx:if="{{product.specDisplayMode === 'matrix'}}" class="matrix-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="stock-matrix" style="min-width: {{product.matrix.minWidth}}rpx">
          <view class="matrix-row matrix-header">
            <view class="matrix-label">颜色 / 尺码</view>
            <view class="matrix-cell" wx:for="{{product.matrix.sizes}}" wx:key="*this">{{item}}</view>
          </view>
          <view class="matrix-row" wx:for="{{product.matrix.rows}}" wx:key="color" wx:for-item="row">
            <view class="matrix-label">{{row.color}}</view>
            <view class="matrix-cell {{cell.tone}}" wx:for="{{row.cells}}" wx:key="size" wx:for-item="cell">{{cell.stockText}}</view>
          </view>
        </view>
      </scroll-view>

      <view wx:elif="{{product.specs.length}}" class="spec-card">
        <view class="spec-row" wx:for="{{product.specs}}" wx:key="id">
          <view class="spec-main"><view>{{item.label}}</view><text class="{{item.status.tone}}">{{item.status.label}}</text></view>
          <view class="spec-stock">{{item.stockText}}<text>件</text></view>
        </view>
      </view>
      <view wx:else class="section-empty">暂未设置规格</view>
    </block>

    <block wx:else>
      <view class="detail-section-title">化妆品信息</view>
      <view wx:if="{{product.cosmetics.fields.length || product.cosmetics.expiry}}" class="cosmetics-card">
        <view class="cosmetics-row" wx:for="{{product.cosmetics.fields}}" wx:key="label"><text>{{item.label}}</text><view>{{item.value}}</view></view>
        <view wx:if="{{product.cosmetics.expiry}}" class="expiry-row">
          <text>保质期状态</text>
          <view class="expiry-status {{product.cosmetics.expiry.tone}}">{{product.cosmetics.expiry.label}}</view>
        </view>
      </view>
      <view wx:else class="section-empty">暂未录入品牌、批次或到期信息</view>

      <view class="detail-section-head">
        <view class="detail-section-title">规格库存</view>
        <text>{{product.specCountText}} 个规格</text>
      </view>
      <view wx:if="{{product.cosmetics.specs.length}}" class="spec-card">
        <view class="spec-row" wx:for="{{product.cosmetics.specs}}" wx:key="id">
          <view class="spec-main"><view>{{item.label}}</view><text class="{{item.status.tone}}">{{item.status.label}}</text></view>
          <view class="spec-stock">{{item.stockText}}<text>件</text></view>
        </view>
      </view>
      <view wx:else class="section-empty">暂未设置规格</view>
    </block>

    <view wx:if="{{canEditProduct}}" class="detail-management-row">
      <view><text>商品资料</text><view>名称、货号和基础资料</view></view>
      <button disabled="{{isNavigating}}" bindtap="openEdit">编辑商品</button>
    </view>
    <view wx:else class="detail-readonly-note">商品资料请联系店主在管理后台维护</view>

    <view wx:if="{{!product.isActive}}" class="detail-inactive-note">该商品已停用，仅可查看历史资料；请先在网页后台重新启用后再卖货或拿货。</view>

    <view wx:if="{{product.isActive}}" class="detail-action-bar">
      <button class="purchase-button" disabled="{{isNavigating}}" bindtap="openPurchase">拿货</button>
      <button class="sale-button" disabled="{{isNavigating}}" bindtap="openSale">卖货</button>
    </view>
  </block>
</view>
