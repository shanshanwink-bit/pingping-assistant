.product-head { display: flex; gap: 24rpx; align-items: center; padding: 20rpx 0 30rpx; }
.detail-image,
.detail-placeholder { width: 150rpx; height: 150rpx; border-radius: 30rpx; }
.detail-placeholder { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; background: #fde5ee; color: #b54c75; font-size: 42rpx; }
.head-main { flex: 1; min-width: 0; }
.detail-name { font-size: 36rpx; font-weight: 600; }
.detail-code { margin: 10rpx 0 16rpx; color: #8f7983; font-size: 24rpx; }
.cost-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-bottom: 18rpx; }
.cost-summary > view { min-width: 0; padding: 20rpx 21rpx; border: 2rpx solid rgba(255,255,255,.9); border-radius: 23rpx; background: rgba(255,255,255,.64); box-shadow: 0 12rpx 29rpx rgba(75,132,172,.08); }
.cost-summary > view > text { color: #7d94a4; font-size: 19rpx; }
.cost-summary > view > view { margin-top: 7rpx; overflow: hidden; color: #315f7d; font-size: 27rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.cost-summary > view > view text { font-size: 18rpx; font-weight: 400; }
.cost-summary .stock-cost { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, rgba(220,242,255,.78), rgba(255,229,240,.76)); }
.cost-summary .stock-cost > view { margin-top: 0; color: #c65380; font-size: 31rpx; }
.info-card { padding: 10rpx 24rpx; }
.info-card > view { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f3e7ec; }
.info-card > view:last-child { border-bottom: 0; }
.info-card text:first-child { color: #8f7983; }
.spec-count { color: #7c8780; font-size: 24rpx; }
.spec-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; border-bottom: 1rpx solid #f3e7ec; }
.spec-row:last-child { border-bottom: 0; }
.spec-row > view:first-child { flex: 1; min-width: 0; }
.spec-name { overflow: hidden; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
.spec-status { margin-top: 6rpx; color: #bd577d; font-size: 22rpx; }
.warning-text { color: #a26705; }
.spec-stock-editor { display: flex; flex: 0 0 auto; width: 126rpx; height: 58rpx; box-sizing: border-box; align-items: center; padding: 0 13rpx; border: 1rpx solid rgba(255,255,255,.92); border-radius: 16rpx; background: rgba(255,255,255,.7); box-shadow: 0 7rpx 18rpx rgba(75,132,172,.08); }
.spec-stock-editor input { flex: 1; min-width: 0; height: 58rpx; color: #29485f; text-align: right; font-size: 29rpx; font-weight: 600; }
.spec-stock-editor text { margin-left: 7rpx; color: #7890a0; font-size: 21rpx; }
.detail-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 34rpx; }
.detail-actions .full { grid-column: 1 / -1; }
.product-maintenance { display: flex; justify-content: center; gap: 18rpx; margin-top: 28rpx; }
.edit-product-button,
.delete-product-button { width: 176rpx; height: 58rpx; margin: 0; padding: 0; border-radius: 999rpx; background: rgba(255,255,255,.48); font-size: 23rpx; line-height: 58rpx; box-shadow: none; }
.edit-product-button { border: 1rpx solid rgba(78,157,205,.34); color: #4e91bb; }
.delete-product-button { border: 1rpx solid rgba(215,111,143,.35); color: #c26a85; }
